# Reverse proxy + automatic HTTPS (Let's Encrypt) for the whole app on ONE domain.
# DOMAIN and ACME_EMAIL come from the environment (set in .env, passed by compose).

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Access log: one JSON line per request (method, path, status, remote IP, duration).
	# View live with: docker compose ... logs -f caddy
	log {
		output stdout
		format console
	}

	# REST API + private file streaming (KYC id-cards go through the backend).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Public assets only: team & league logos, served straight from MinIO.
	# id-cards are NOT routed here, so they never become publicly reachable.
	@publicAssets path /storage/teams/* /storage/leagues/*
	handle @publicAssets {
		uri strip_prefix /storage
		reverse_proxy minio:9000
	}

	# Everything else -> the SPA (frontend nginx handles Vue history-mode fallback).
	handle {
		reverse_proxy frontend:80
	}
}

# Self-hosted analytics (umami) on its own subdomain, with its own auto-TLS cert.
# It needs a whole origin to itself: the tracker posts to /api/send, which would
# collide with the backend's /api/* on the main domain. DuckDNS resolves any
# *.<name>.duckdns.org to the same IP, so no extra DNS record is required.
{$ANALYTICS_DOMAIN} {
	encode gzip

	log {
		output stdout
		format console
	}

	reverse_proxy umami:3000
}
