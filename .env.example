DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
SWAGGER_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
FRONTEND_URL=http://localhost:3000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=http://localhost:3000/storage
FOOTBALL_DATA_TOKEN=
VITE_API_BASE_URL=
# Password of the 510 demo accounts created by POST /api/admin/sync/seed (dev only: the
# endpoint is refused under the prod profile, and refuses to run while this is empty)
SEED_USER_PASSWORD=

# --- Production (VPS) only. See application-prod.properties + docker-compose.prod.yml ---
# SPRING_PROFILES_ACTIVE=prod
# DOMAIN=demo.duckdns.org            # your public domain (Caddy issues TLS for it)
# ACME_EMAIL=you@example.com         # Let's Encrypt contact
# BEHIND_PROXY=true                  # trust X-Forwarded-For from Caddy
# DDL_AUTO=validate                  # first empty-DB boot: set to 'update' once, then remove
# In prod set these to your domain (same-origin, so CORS is mostly moot but keep it tight):
#   CORS_ALLOWED_ORIGINS=https://demo.duckdns.org
#   MINIO_PUBLIC_URL=https://demo.duckdns.org/storage
#   FRONTEND_URL=https://demo.duckdns.org      # used in verification/reset e-mails
#   VITE_API_BASE_URL=                          # leave EMPTY -> axios uses window.location.origin

# --- Self-hosted analytics (umami, prod overlay) ---
# ANALYTICS_DOMAIN=analytics.demo.duckdns.org   # own subdomain; DuckDNS resolves *.<name>.duckdns.org
# UMAMI_APP_SECRET=                             # random string: openssl rand -hex 32
# ANALYTICS_ALLOWED_IPS=203.0.113.7            # IPs/CIDRs (space-separated) allowed to open the
#                                               # dashboard; unset = nobody. Find yours: curl ifconfig.me
# UMAMI_DB_USER=umami                           # umami's own Postgres role (owns only the umami DB)
# UMAMI_DB_PASSWORD=                            # URL-safe (it goes into DATABASE_URL): openssl rand -hex 24
# One-time on the VM (and again after changing UMAMI_DB_PASSWORD): create the role and the umami
# database, and hand the role any umami tables an earlier deploy created as the superuser
# (db must be running; load .env into the shell first with: set -a; . ./.env; set +a):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml exec -T db \
#     psql -U "$DB_USERNAME" -d postgres -v ON_ERROR_STOP=1 \
#       -v umami_user="$UMAMI_DB_USER" -v umami_password="$UMAMI_DB_PASSWORD" < docs/umami-db.sql
# Then sign in at https://<ANALYTICS_DOMAIN> from an allowed IP (default admin/umami — CHANGE IT),
# create the website, copy its website-id into Kickoffbet-ui/index.html, and rebuild the frontend.
